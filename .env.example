# Copy to .env locally. Never commit real credentials.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Local model name used by Ollama (no API key required)
OLLAMA_MODEL=qwen3.5:0.8b

# Telegram bot token: configure only in a private server environment.
# Never commit the real token or paste it into chat/issues.
TELEGRAM_BOT_TOKEN=

# Private owner authentication. Keep the setup token secret and out of Git.
# Generate a random value of at least 32 characters in your private environment.
AUTOPILOT_SETUP_TOKEN=
AUTH_COOKIE_SECURE=true
